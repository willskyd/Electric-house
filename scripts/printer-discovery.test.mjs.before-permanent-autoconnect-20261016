import assert from 'node:assert/strict';
import test from 'node:test';
import { chooseBluetoothPrinterCandidate, parseConnectedRfcomm } from './printer-discovery.mjs';

test('prefers the paired printer that is actually connected and exposes the serial-port service', () => {
  const info = [
    'Device 41:42:F1:9D:4B:5B (public)',
    '\tName: TWS',
    '\tAlias: TWS',
    '\tClass: 0x00240404 (2360324)',
    '\tIcon: audio-headset',
    '\tConnected: no',
    '\tUUID: Audio Sink (0000110b-0000-1000-8000-00805f9b34fb)',
    '',
    'Device 86:67:7A:92:30:AE (public)',
    '\tName: MPT-II_30AE',
    '\tAlias: MPT-II_30AE',
    '\tClass: 0x00040680 (263808)',
    '\tIcon: printer',
    '\tConnected: yes',
    '\tUUID: Serial Port (00001101-0000-1000-8000-00805f9b34fb)',
  ].join('\n');

  assert.equal(chooseBluetoothPrinterCandidate(info), '86:67:7A:92:30:AE');
});

test('finds every connected RFCOMM device and ignores disconnected devices', () => {
  const parsed = parseConnectedRfcomm([
    'rfcomm0: E8:6F:38:39:38:5A -> 86:67:7A:92:30:AE channel 1 connected [reuse-dlc release-on-hup tty-attached]',
    'rfcomm1: E8:6F:38:39:38:5A -> 22:33:44:55:66:77 channel 2 connected [tty-attached]',
    'rfcomm2: E8:6F:38:39:38:5A -> AA:BB:CC:DD:EE:FF channel 1 disconnected',
    'not a device line',
  ].join('\n'));
  assert.deepEqual(parsed.map((printer) => printer.device), ['/dev/rfcomm0', '/dev/rfcomm1']);
  assert.equal(parsed[0].address, '86:67:7A:92:30:AE');
  assert.equal(parsed[1].channel, 2);
});
