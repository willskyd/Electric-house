import http from 'node:http';
import fs from 'node:fs/promises';

const HOST = '127.0.0.1';
const PORT = 17891;
const DEVICE = '/dev/rfcomm0';

const server = http.createServer(async (req, res) => {
  res.setHeader('Cache-Control', 'no-store');
  res.setHeader('X-Content-Type-Options', 'nosniff');

  if (req.method === 'GET' && req.url === '/health') {
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({ ok: true, device: DEVICE }));
    return;
  }

  if (req.method !== 'POST' || req.url !== '/print-test') {
    res.writeHead(404);
    res.end('Not found');
    return;
  }

  // Reject browser requests from other websites.
  const origin = req.headers.origin;
  const allowedOrigins = new Set([
    'http://localhost:3000',
    'http://127.0.0.1:3000',
  ]);

  if (origin && !allowedOrigins.has(origin)) {
    res.writeHead(403);
    res.end('Origin not allowed');
    return;
  }

  try {
    const chunks = [];
    let size = 0;

    for await (const chunk of req) {
      size += chunk.length;
      if (size > 1024) {
        res.writeHead(413);
        res.end('Request too large');
        return;
      }
      chunks.push(chunk);
    }

    const body = JSON.parse(Buffer.concat(chunks).toString('utf8'));

    if (body.confirm !== 'PRINT-MICRO-MEC-TEST') {
      res.writeHead(400, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ ok: false, error: 'Invalid test confirmation' }));
      return;
    }

    const text = Buffer.from(
      '\x1b@' +
      'MICRO-MEC PRINTER TEST\n' +
      'Bluetooth connection OK\n' +
      '------------------------\n\n\n' +
      '\x1dV\x00',
      'binary'
    );

    await fs.writeFile(DEVICE, text);

    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({ ok: true, message: 'Test sent to printer' }));
  } catch (error) {
    console.error('Print test failed:', error.message);
    res.writeHead(500, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({
      ok: false,
      error: 'Could not write to printer. Check Bluetooth connection and device permissions.',
    }));
  }
});

server.listen(PORT, HOST, () => {
  console.log(`Micro-mec printer bridge listening at http://${HOST}:${PORT}`);
  console.log('Test endpoint: POST /print-test');
  console.log('Keep this terminal open while testing.');
});
